{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "custom.regex",
    "github-actions",
    "git-submodules"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "hugo-version:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?"
      ],
      "depNameTemplate": "gohugoio/hugo",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "WRANGLER_VERSION:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?"
      ],
      "depNameTemplate": "wrangler",
      "datasourceTemplate": "npm"
    }
  ],
  "minimumReleaseAge": "2 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "prHourlyLimit": 1,
  "timezone": "Europe/Copenhagen",
  "schedule": [
    "at any time"
  ],
  "packageRules": [
    {
      "description": "Node 26+ links libatomic.so.1, which the self-hosted runner does not provide. setup-node exits 127 and deploys are skipped. Stay on Node 24.",
      "matchManagers": ["github-actions"],
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["node", "actions/node-versions"],
      "allowedVersions": "<25"
    }
  ]
}
